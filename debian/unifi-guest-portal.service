[Unit]
Description=UniFi Guest Portal with Slack Integration
After=network.target

[Service]
Type=simple
User=unifi-portal
WorkingDirectory=/usr/share/unifi-guest-portal
Environment="NODE_ENV=production"
Environment="CONFIG_PATH=/etc/unifi-guest-portal/config.env"
EnvironmentFile=/etc/unifi-guest-portal/config.env
EnvironmentFile=-/run/unifi-guest-portal/secret.env

RuntimeDirectory=unifi-guest-portal
RuntimeDirectoryMode=0755

ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=unifi-guest-portal

[Install]
WantedBy=multi-user.target
