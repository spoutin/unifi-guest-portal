PORTAL_PORT=3000
# PORTAL_HOST=127.0.0.1 # Uncomment to only listen on localhost (useful behind reverse proxies)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_CHANNEL_ID=C00000000
UNIFI_CONTROLLER_URL=https://192.168.1.10:8443
UNIFI_USERNAME=admin
UNIFI_PASSWORD=yourpassword
# UNIFI_API_KEY=your_local_api_key_here # Use this instead of UNIFI_USERNAME and UNIFI_PASSWORD if supported on your firmware
UNIFI_SITE=default
GUEST_AUTH_DURATION=1440
